def fetch_fred_data(series_id: str, start_date: str, end_date: str) -> pd.DataFrame:
    """
    Fetches economic data from FRED.

    Args:
        series_id (str): FRED series ID (e.g., 'GDP', 'UNRATE').
        start_date (str): Start date in 'YYYY-MM-DD' format.
        end_date (str): End date in 'YYYY-MM-DD' format.

    Returns:
        pd.DataFrame: DataFrame containing the economic data.
                      Returns an empty DataFrame if data fetching fails.
    """
    logger.info(f"Fetching {series_id} data from FRED for {start_date} to {end_date}")
    try:
        data = fred.get_series(series_id, start_date, end_date)
        if data is None or data.empty:
            logger.warning(f"No data found for FRED series {series_id} within the specified date range.")
            return pd.DataFrame()
        else:
            df = pd.DataFrame({series_id: data})
            df.index.name = 'date'
            df.columns = [series_id.lower()] # Standardize column names
            logger.info(f"Successfully fetched {len(df)} rows for FRED series {series_id}.")
            return df
    except Exception as e:
        logger.error(f"Error fetching data for FRED series {series_id}: {e}")
        return pd.DataFrame()

