def log_experiment_results(params: dict, metrics: dict, artifacts: dict = None, model: object = None, model_name: str = "StrategyModel"):
    """
    Logs experiment parameters, metrics, and artifacts to MLflow.

    Args:
        params (dict): Dictionary of parameters used in the experiment (e.g., strategy parameters).
        metrics (dict): Dictionary of performance metrics (e.g., Sharpe, Sortino, MDD).
        artifacts (dict): Optional dictionary where keys are artifact names and values are file paths.
        model (object): Optional trained model object to log (e.g., a sklearn model, or custom class).
                        If a custom class, it should be MLflow-compatible or wrapped.
        model_name (str): Name for the logged model.
    """
    with mlflow.start_run():
        run_id = mlflow.active_run().info.run_id
        logger.info(f"MLflow Run Started with ID: {run_id}")

        # Log parameters
        mlflow.log_params(params)
        logger.info(f"Logged parameters: {params}")

        # Log metrics
        mlflow.log_metrics(metrics)
        logger.info(f"Logged metrics: {metrics}")

        # Log artifacts (e.g., equity curve plot, trade log CSV)
        if artifacts:
            for artifact_name, artifact_path in artifacts.items():
                if os.path.exists(artifact_path):
                    mlflow.log_artifact(local_path=artifact_path, artifact_path=artifact_name)
                    logger.info(f"Logged artifact: {artifact_path} as {artifact_name}")
                else:
                    logger.warning(f"Artifact file not found: {artifact_path}")

        # Log model (if provided)
        if model:
            try:
                # For generic Python objects or custom classes, use mlflow.pyfunc.log_model
                # This requires a pyfunc model wrapper if the model isn't natively supported
                # For now, let's assume a simple case or a path to a model file.
                mlflow.pyfunc.log_model(python_model=model, artifact_path=model_name)
                logger.info(f"Logged model: {model_name}")
            except Exception as e:
                logger.error(f"Error logging model {model_name} to MLflow: {e}")
        
        logger.info(f"MLflow Run {run_id} Finished.")

def load_mlflow_model(run_id: str, model_name: str = "StrategyModel"):
    """
    Loads a model logged with MLflow.

    Args:
        run_id (str): The MLflow run ID where the model was logged.
        model_name (str): The artifact path/name of the model within the run.

    Returns:
        object: The loaded model object, or None if loading fails.
    """
    try:
        model_uri = f"runs:/{run_id}/{model_name}"
        loaded_model = mlflow.pyfunc.load_model(model_uri)
        logger.info(f"Successfully loaded model from {model_uri}")
        return loaded_model
    except Exception as e:
        logger.error(f"Error loading MLflow model {model_name} from run {run_id}: {e}")
        return None


