def plot_equity_curve(equity_curve: pd.DataFrame, strategy_name: str = "Strategy") -> go.Figure:
    """
    Plots the equity curve of a backtest using Plotly.

    Args:
        equity_curve (pd.DataFrame): DataFrame with a 'portfolio_value' column and datetime index.
        strategy_name (str): Name of the strategy to display in the plot title.

    Returns:
        go.Figure: Plotly Figure object.
    """
    if equity_curve.empty or 'portfolio_value' not in equity_curve.columns:
        logger.warning("Empty equity curve or missing 'portfolio_value' column for plotting.")
        return go.Figure()

    logger.info(f"Generating equity curve plot for {strategy_name}.")

    fig = go.Figure()
    fig.add_trace(go.Scatter(x=equity_curve.index, y=equity_curve['portfolio_value'],
                             mode='lines', name=strategy_name,
                             line=dict(color='royalblue', width=2)))

    fig.update_layout(
        title={
            'text': f'{strategy_name} - Equity Curve',
            'y':0.9,
            'x':0.5,
            'xanchor': 'center',
            'yanchor': 'top'},
        xaxis_title="Date",
        yaxis_title="Portfolio Value",
        hovermode="x unified",
        template="plotly_white",
        height=500,
        width=900
    )
    fig.update_yaxes(tickprefix="$")
    logger.info("Equity curve plot generated.")
    return fig

def plot_drawdown(equity_curve: pd.DataFrame, strategy_name: str = "Strategy") -> go.Figure:
    """
    Plots the drawdown curve of a backtest using Plotly.

    Args:
        equity_curve (pd.DataFrame): DataFrame with a 'portfolio_value' column and datetime index.
        strategy_name (str): Name of the strategy to display in the plot title.

    Returns:
        go.Figure: Plotly Figure object.
    """
    if equity_curve.empty or 'portfolio_value' not in equity_curve.columns:
        logger.warning("Empty equity curve or missing 'portfolio_value' column for plotting drawdown.")
        return go.Figure()

    logger.info(f"Generating drawdown plot for {strategy_name}.")

    # Calculate drawdowns
    roll_max = equity_curve['portfolio_value'].expanding().max()
    daily_drawdown = (equity_curve['portfolio_value'] / roll_max - 1)

    fig = go.Figure()
    fig.add_trace(go.Scatter(x=daily_drawdown.index, y=daily_drawdown,
                             mode='lines', name='Drawdown',
                             fill='tozeroy', fillcolor='rgba(255,0,0,0.3)',
                             line=dict(color='red', width=1)))

    fig.update_layout(
        title={
            'text': f'{strategy_name} - Drawdown',
            'y':0.9,
            'x':0.5,
            'xanchor': 'center',
            'yanchor': 'top'},
        xaxis_title="Date",
        yaxis_title="Drawdown (%)",
        hovermode="x unified",
        template="plotly_white",
        height=500,
        width=900
    )
    fig.update_yaxes(tickformat=".2%")
    logger.info("Drawdown plot generated.")
    return fig

def generate_performance_report(metrics: dict, strategy_name: str = "Strategy") -> str:
    """
    Generates a text-based performance report.

    Args:
        metrics (dict): Dictionary of performance metrics.
        strategy_name (str): Name of the strategy.

    Returns:
        str: Formatted performance report string.
    """
    logger.info(f"Generating performance report for {strategy_name}.")
    report = f"--- Performance Report for {strategy_name} ---\n"
    for key, value in metrics.items():
        if isinstance(value, (int, float)):
            if '_ratio' in key or '_return' in key or '_drawdown' in key or 'VaR' in key or 'CVaR' in key:
                report += f"{key.replace('_', ' ').title()}: {value:.2%}\n"
            else:
                report += f"{key.replace('_', ' ').title()}: {value:,.2f}\n"
        else:
            report += f"{key.replace('_', ' ').title()}: {value}\n"
    report += "--------------------------------------\n"
    logger.info("Performance report generated.")
    return report

def plot_multiple_equity_curves(equity_curves_dict: dict, title: str = "Multiple Strategy Equity Curves") -> go.Figure:
    """
    Plots multiple equity curves on a single chart using Plotly.

    Args:
        equity_curves_dict (dict): A dictionary where keys are strategy names and values are
                                   DataFrames with a 'portfolio_value' column and datetime index.
        title (str): Title for the combined plot.

    Returns:
        go.Figure: Plotly Figure object.
    """
    logger.info(f"Generating combined equity curve plot: {title}.")
    fig = go.Figure()

    for strategy_name, equity_curve_df in equity_curves_dict.items():
        if not equity_curve_df.empty and 'portfolio_value' in equity_curve_df.columns:
            fig.add_trace(go.Scatter(x=equity_curve_df.index, y=equity_curve_df['portfolio_value'],
                                     mode='lines', name=strategy_name))
        else:
            logger.warning(f"Skipping empty or invalid equity curve for strategy: {strategy_name}")

    fig.update_layout(
        title={
            'text': title,
            'y':0.9,
            'x':0.5,
            'xanchor': 'center',
            'yanchor': 'top'},
        xaxis_title="Date",
        yaxis_title="Portfolio Value",
        hovermode="x unified",
        template="plotly_white",
        height=600,
        width=1000
    )
    fig.update_yaxes(tickprefix="$")
    logger.info("Combined equity curve plot generated.")
    return fig


